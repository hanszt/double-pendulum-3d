<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hzt.controller.sub_pane.StatisticsController">
    <Label text="Global statistics:">
        <font>
            <Font name="System Bold" size="12.0"/>
        </font>
    </Label>
    <HBox>
        <VBox prefWidth="100.0">
            <Label text="Framerate:"/>
            <Label text="Runtime:"/>
            <Label/>
        </VBox>
        <VBox layoutX="10.0" layoutY="10.0">
            <Label fx:id="frameRateStatsLabel" text="NaN"/>
            <Label fx:id="runTimeLabel" text="NaN"/>
            <Label/>
        </VBox>
    </HBox>
    <Label text="Pendulum statistics:">
        <font>
            <Font name="System Bold" size="12.0"/>
        </font>
    </Label>
    <HBox>
        <VBox prefWidth="100.0">
            <Label text="Upper length: "/>
            <Label text="Lower length: "/>
            <Label text="Upper mass: "/>
            <Label text="Lower mass: "/>
            <Label text="Upper mass x: "/>
            <Label text="Upper mass y: "/>
            <Label text="Lower mass x: "/>
            <Label text="Lower mass y: "/>

            <Label text="Angle 1: "/>
            <Label text="Angle 2: "/>
            <Label text="V angular 1: "/>
            <Label text="V angular 2: "/>
            <Label text="A angular 1: "/>
            <Label text="A angular 2: "/>
            <Label text="Trace size:"/>
            <Label/>
            <Label text="Friction: "/>

            <Label text="Position x:"/>
            <Label text="Position y:"/>
            <Label text="Position z:"/>

            <Label text="Rotation x:"/>
            <Label text="Rotation y:"/>
        </VBox>
        <VBox layoutX="10.0" layoutY="10.0">
            <Label fx:id="upperPendulumLengthLabel"/>
            <Label fx:id="lowerPendulumLengthLabel"/>
            <Label fx:id="upperMassLabel"/>
            <Label fx:id="lowerMassLabel"/>
            <Label fx:id="upperMassXLabel"/>
            <Label fx:id="upperMassYLabel"/>
            <Label fx:id="lowerMassXLabel"/>
            <Label fx:id="lowerMassYLabel"/>

            <Label fx:id="angle1Label"/>
            <Label fx:id="angle2Label"/>
            <Label fx:id="vAngular1Label"/>
            <Label fx:id="vAngular2Label"/>
            <Label fx:id="aAngular1Label"/>
            <Label fx:id="aAngular2Label"/>
            <Label fx:id="traceSizeLabel"/>
            <Label/>
            <Label fx:id="frictionLabel"/>

            <Label fx:id="positionXLabel"/>
            <Label fx:id="positionYLabel"/>
            <Label fx:id="positionZLabel"/>

            <Label fx:id="rotationXLabel"/>
            <Label fx:id="rotationYLabel"/>
        </VBox>
    </HBox>
    <Label text="Camera Statistics:">
        <font>
            <Font name="System Bold" size="12.0"/>
        </font>
    </Label>
    <HBox>
        <children>
            <VBox minWidth="100.0" prefWidth="100.0">
                <children>
                    <Label text="Position x:"/>
                    <Label text="Position y:"/>
                    <Label text="Position z:"/>

                    <Label text="Velocity:"/>
                    <Label text="Field of view: "/>
                </children>
            </VBox>
            <VBox layoutX="10.0" layoutY="10.0" prefWidth="188.0">
                <children>
                    <Label fx:id="positionCameraXLabel"/>
                    <Label fx:id="positionCameraYLabel"/>
                    <Label fx:id="positionCameraZLabel"/>

                    <Label fx:id="velocityCameraLabel"/>
                    <Label fx:id="fieldOfViewCameraLabel"/>
                </children>
            </VBox>
        </children>
    </HBox>
</VBox>

